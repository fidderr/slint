// The area a Flickable has (here: the part the virtual keyboard leaves free) and the height of its content change
// while a spring back to the limit is running. The spring ended at the limit it was started with,
// which left the content past the new limit, and the next press found content that its release moved.

export component TestCase inherits Window {
    width: 400px;
    height: 800px;

    fli := Flickable {
        x: 0px;
        y: 0px;
        width: 300px;
        height: 600px;
        content-width: 300px;
        content-height: 700px;

        Rectangle {
            y: 100px;
            height: 50px;
            TouchArea {
                clicked => { root.clicks += 1; }
            }
        }
    }

    in-out property <int> clicks;
    in-out property fli_content_height <=> fli.content_height;
    in-out property fli_content_y <=> fli.content_y;
}

/*
```rust
use slint::*;
use slint_testing::AutoBool;

fn keyboard(instance: &TestCase, height: f32) {
    instance.window().set_virtual_keyboard(
        LogicalPosition::new(0., 800. - height),
        LogicalSize::new(400., height),
        i_slint_core::InternalToken,
    );
}

// The keyboard covers the lower 400 points: the area is 400 high and the end of the content is at -300.
fn with_keyboard() -> TestCase {
    let instance = TestCase::new().unwrap();
    let flickable = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::fli")
        .next()
        .unwrap();
    slint_testing::set_flickable_physics(&flickable, AutoBool::On, AutoBool::Off);
    keyboard(&instance, 400.);
    slint_testing::mock_elapsed_time(1);
    // Past the end: a spring back to -300 starts.
    instance.set_fli_content_y(-340.);
    slint_testing::mock_elapsed_time(1);
    slint_testing::mock_elapsed_time(50);
    assert!(instance.get_fli_content_y() < -300., "the spring has not started: {}", instance.get_fli_content_y());
    instance
}

fn settle() {
    for _ in 0..40 {
        slint_testing::mock_elapsed_time(100);
    }
}

fn click(instance: &TestCase) {
    let position = LogicalPosition::new(100., 125.);
    let window = instance.window();
    window.dispatch_event(platform::WindowEvent::PointerPressed { position, button: platform::PointerEventButton::Left });
    window.dispatch_event(platform::WindowEvent::PointerReleased { position, button: platform::PointerEventButton::Left });
    slint_testing::mock_elapsed_time(500);
}

// The keyboard goes down and the content gets shorter so that it fits, in one go: the limit is 0.
let instance = with_keyboard();
keyboard(&instance, 0.);
instance.set_fli_content_height(600.);
settle();
assert_eq!(instance.get_fli_content_y(), 0.);
click(&instance);
assert_eq!(instance.get_clicks(), 1, "the click did not land on the element");
assert_eq!(instance.get_fli_content_y(), 0.);

// The keyboard goes down and the content still does not fit: the limit moves to -101.
let instance = with_keyboard();
keyboard(&instance, 0.);
instance.set_fli_content_height(701.);
settle();
assert_eq!(instance.get_fli_content_y(), -101.);
```
*/
